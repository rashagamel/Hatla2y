# Copy to .env (never commit .env) or set these in the host's environment settings.
SECRET_KEY=paste-a-random-string-of-at-least-32-characters
TASAHEL_REQUIRE_AUTH=1          # 1 = login required for every API call (use this in production)
TASAHEL_BOOTSTRAP=1             # 1 = create tables + seed default users/agents on start (first deploy only)
COPILOT_DB_PATH=/data/copilot.db
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
ANTHROPIC_API_KEY=
PORT=5050
# First start only (when TASAHEL_REQUIRE_AUTH=1): creates this one admin. No default passwords are created in production.
TASAHEL_ADMIN_EMAIL=you@yourcompany.com
TASAHEL_ADMIN_PASSWORD=a-long-private-password
# Fresh server only: load the listings automatically when the properties table is empty
TASAHEL_SEED_CSV=data/real/egypt_real_estate_listings.csv
